#Область ПубличныйИнтерфейс

Функция ОбработатьПакет(
	Обработчик,
	Настройки,
	ПолитикаПовторов = Неопределено,
	Момент = Неопределено) Экспорт

	KafkaИнтеграцияКонтракты.ПроверитьНастройки(Настройки);
	Если ПолитикаПовторов = Неопределено Тогда
		ПолитикаПовторов = KafkaИнтеграцияПовторы.НоваяПолитика(Настройки.МаксимумПопыток);
	КонецЕсли;
	Если Момент = Неопределено Тогда
		Момент = ТекущаяДатаСеанса();
	КонецЕсли;

	Сообщения = KafkaИнтеграцияХранилище.ПолучитьКОбработке(
		Настройки.ВидОбмена,
		Момент,
		ПолитикаПовторов.МаксимумПопыток,
		Настройки.РазмерПакета);
	Статистика = НоваяСтатистика(Сообщения.Количество());

	Для Каждого Сообщение Из Сообщения Цикл
		ОбработатьСообщение(Обработчик, Настройки, Сообщение, ПолитикаПовторов, Момент, Статистика);
	КонецЦикла;

	Возврат Статистика;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьСообщение(Обработчик, Настройки, Сообщение, ПолитикаПовторов, Момент, Статистика)

	ИдентификаторБлокировки = KafkaИнтеграцияХранилище.ПопытатьсяЗахватить(Сообщение, Момент);
	Если ПустаяСтрока(ИдентификаторБлокировки) Тогда
		Статистика.Пропущено = Статистика.Пропущено + 1;
		Возврат;
	КонецЕсли;

	ДанныеСообщения = ДанныеДляОбработчика(Сообщение);
	Попытка
		Обработчик.Обработать(ДанныеСообщения);
	Исключение
		Завершено = KafkaИнтеграцияХранилище.ЗавершитьОшибкой(
			Сообщение,
			ИдентификаторБлокировки,
			"handler_exception",
			ПолитикаПовторов,
			Момент);
		Если Завершено Тогда
			Статистика.Ошибок = Статистика.Ошибок + 1;
			KafkaИнтеграцияБезопасныйЖурнал.ЗаписатьОшибку(
				"process",
				Настройки.ПсевдонимБрокера,
				Сообщение.ИдентификаторСообщения,
				"handler_exception");
		Иначе
			Статистика.ПотеряноБлокировок = Статистика.ПотеряноБлокировок + 1;
		КонецЕсли;
		Возврат;
	КонецПопытки;

	Завершено = KafkaИнтеграцияХранилище.ЗавершитьУспешно(
		Сообщение,
		ИдентификаторБлокировки,
		"ok",
		Момент);
	Если Завершено Тогда
		Статистика.Обработано = Статистика.Обработано + 1;
		KafkaИнтеграцияБезопасныйЖурнал.ЗаписатьИнформацию(
			"process",
			Настройки.ПсевдонимБрокера,
			Сообщение.ИдентификаторСообщения);
	Иначе
		Статистика.ПотеряноБлокировок = Статистика.ПотеряноБлокировок + 1;
	КонецЕсли;

КонецПроцедуры

Функция ДанныеДляОбработчика(Сообщение)

	Данные = Новый Структура;
	Данные.Вставить("ИдентификаторСообщения", Сообщение.ИдентификаторСообщения);
	Данные.Вставить("ИдентификаторПакета", Сообщение.ИдентификаторПакета);
	Данные.Вставить("Топик", Сообщение.Топик);
	Данные.Вставить("Ключ", Сообщение.КлючСообщения);
	Данные.Вставить("Тело", Сообщение.ТекстСообщения);
	Данные.Вставить(
		"Заголовки",
		KafkaИнтеграцияКонтракты.ДесериализоватьЗаголовки(Сообщение.ЗаголовкиJSON));
	Данные.Вставить("Партиция", Сообщение.Партиция);
	Данные.Вставить("Смещение", Сообщение.Смещение);
	Данные.Вставить("ДатаСоздания", Сообщение.ДатаСоздания);
	Возврат Данные;

КонецФункции

Функция НоваяСтатистика(Выбрано)

	Статистика = Новый Структура;
	Статистика.Вставить("Выбрано", Выбрано);
	Статистика.Вставить("Обработано", 0);
	Статистика.Вставить("Ошибок", 0);
	Статистика.Вставить("Пропущено", 0);
	Статистика.Вставить("ПотеряноБлокировок", 0);
	Возврат Статистика;

КонецФункции

#КонецОбласти
