#Область ПубличныйИнтерфейс

Функция НовыеНастройки(
	ВидОбмена,
	ПсевдонимБрокера,
	ТопикВходящих,
	ТопикИсходящих,
	ГруппаКонсьюмера,
	КлиентПродюсера,
	РазмерПакета = 100,
	ТаймаутОпросаМс = 1000,
	МаксимумПопыток = 5) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ВидОбмена", ВидОбмена);
	Настройки.Вставить("ПсевдонимБрокера", ПсевдонимБрокера);
	Настройки.Вставить("ТопикВходящих", ТопикВходящих);
	Настройки.Вставить("ТопикИсходящих", ТопикИсходящих);
	Настройки.Вставить("ГруппаКонсьюмера", ГруппаКонсьюмера);
	Настройки.Вставить("КлиентПродюсера", КлиентПродюсера);
	Настройки.Вставить("РазмерПакета", РазмерПакета);
	Настройки.Вставить("ТаймаутОпросаМс", ТаймаутОпросаМс);
	Настройки.Вставить("МаксимумПопыток", МаксимумПопыток);

	ПроверитьНастройки(Настройки);
	Возврат Настройки;

КонецФункции

Процедура ПроверитьНастройки(Настройки) Экспорт

	ПроверитьПоле(Настройки, "ВидОбмена");
	ПроверитьСтроку(Настройки, "ПсевдонимБрокера");
	ПроверитьСтроку(Настройки, "ГруппаКонсьюмера");
	ПроверитьСтроку(Настройки, "КлиентПродюсера");
	ПроверитьПоложительноеЧисло(Настройки, "РазмерПакета");
	ПроверитьПоложительноеЧисло(Настройки, "ТаймаутОпросаМс");
	ПроверитьПоложительноеЧисло(Настройки, "МаксимумПопыток");

	Если ПустаяСтрока(Настройки.ТопикВходящих) И ПустаяСтрока(Настройки.ТопикИсходящих) Тогда
		ВызватьИсключение "Должен быть задан хотя бы один топик";
	КонецЕсли;

КонецПроцедуры

Функция НовоеИсходящееСообщение(
	ВидОбмена,
	ИдентификаторСообщения,
	Топик,
	КлючСообщения,
	ТекстСообщения,
	Заголовки = Неопределено,
	ИдентификаторПакета = "",
	ДатаСоздания = Неопределено) Экспорт

	Если ДатаСоздания = Неопределено Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Сообщение = НоваяСтруктураСообщения();
	Сообщение.ВидОбмена = ВидОбмена;
	Сообщение.ВидСообщения = "Исходящее";
	Сообщение.ИдентификаторСообщения = ИдентификаторСообщения;
	Сообщение.ИдентификаторПакета = ИдентификаторПакета;
	Сообщение.Топик = Топик;
	Сообщение.КлючСообщения = КлючСообщения;
	Сообщение.ТекстСообщения = ТекстСообщения;
	Сообщение.Заголовки = НормализоватьЗаголовки(Заголовки);
	Сообщение.ДатаСоздания = ДатаСоздания;

	ПроверитьСообщение(Сообщение);
	Возврат Сообщение;

КонецФункции

Функция НовоеВходящееСообщение(
	ВидОбмена,
	Топик,
	КлючСообщения,
	ТекстСообщения,
	Заголовки,
	Партиция,
	Смещение,
	ВременнаяМетка = Неопределено) Экспорт

	Если ВременнаяМетка = Неопределено Тогда
		ВременнаяМетка = ТекущаяДатаСеанса();
	КонецЕсли;

	Сообщение = НоваяСтруктураСообщения();
	Сообщение.ВидОбмена = ВидОбмена;
	Сообщение.ВидСообщения = "Входящее";
	Сообщение.ИдентификаторСообщения = ИдентификаторПоПозиции(Топик, Партиция, Смещение);
	Сообщение.Топик = Топик;
	Сообщение.КлючСообщения = КлючСообщения;
	Сообщение.ТекстСообщения = ТекстСообщения;
	Сообщение.Заголовки = НормализоватьЗаголовки(Заголовки);
	Сообщение.Партиция = Партиция;
	Сообщение.Смещение = Смещение;
	Сообщение.ДатаСоздания = ВременнаяМетка;

	ПроверитьСообщение(Сообщение);
	Возврат Сообщение;

КонецФункции

Функция ИдентификаторПоПозиции(Топик, Партиция, Смещение) Экспорт

	Если ПустаяСтрока(Топик) Или Партиция < 0 Или Смещение < 0 Тогда
		ВызватьИсключение "Некорректная позиция Kafka-сообщения";
	КонецЕсли;

	Возврат Топик + ":" + СтрокаБезПробелов(Партиция) + ":" + СтрокаБезПробелов(Смещение);

КонецФункции

Процедура ПроверитьСообщение(Сообщение) Экспорт

	ПроверитьПоле(Сообщение, "ВидОбмена");
	ПроверитьСтроку(Сообщение, "ВидСообщения");
	ПроверитьСтроку(Сообщение, "ИдентификаторСообщения");
	ПроверитьСтроку(Сообщение, "Топик");

	Если Сообщение.ВидСообщения <> "Входящее" И Сообщение.ВидСообщения <> "Исходящее" Тогда
		ВызватьИсключение "Неизвестный вид Kafka-сообщения";
	КонецЕсли;

КонецПроцедуры

Функция СериализоватьЗаголовки(Заголовки) Экспорт

	НормализованныеЗаголовки = НормализоватьЗаголовки(Заголовки);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, НормализованныеЗаголовки);
	Возврат Запись.Закрыть();

КонецФункции

Функция ДесериализоватьЗаголовки(ЗаголовкиJSON) Экспорт

	Если ПустаяСтрока(ЗаголовкиJSON) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ЗаголовкиJSON);
	Заголовки = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат НормализоватьЗаголовки(Заголовки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяСтруктураСообщения()

	Сообщение = Новый Структура;
	Сообщение.Вставить("ВидОбмена");
	Сообщение.Вставить("ВидСообщения");
	Сообщение.Вставить("ИдентификаторСообщения", "");
	Сообщение.Вставить("ИдентификаторПакета", "");
	Сообщение.Вставить("Топик", "");
	Сообщение.Вставить("КлючСообщения", "");
	Сообщение.Вставить("ТекстСообщения", "");
	Сообщение.Вставить("Заголовки", Новый Соответствие);
	Сообщение.Вставить("Партиция", -1);
	Сообщение.Вставить("Смещение", -1);
	Сообщение.Вставить("ДатаСоздания");
	Возврат Сообщение;

КонецФункции

Функция НормализоватьЗаголовки(Заголовки)

	Результат = Новый Соответствие;
	Если Заголовки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ТипЗаголовков = ТипЗнч(Заголовки);
	Если ТипЗаголовков <> Тип("Соответствие") И ТипЗаголовков <> Тип("Структура") Тогда
		ВызватьИсключение "Заголовки должны быть структурой или соответствием";
	КонецЕсли;

	Для Каждого Заголовок Из Заголовки Цикл
		Результат.Вставить(Строка(Заголовок.Ключ), Строка(Заголовок.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПроверитьПоле(СтруктураДанных, ИмяПоля)

	ЗначениеПоля = Неопределено;
	Если НЕ СтруктураДанных.Свойство(ИмяПоля, ЗначениеПоля) Или ЗначениеПоля = Неопределено Тогда
		ВызватьИсключение "Не заполнено поле " + ИмяПоля;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтроку(СтруктураДанных, ИмяПоля)

	ПроверитьПоле(СтруктураДанных, ИмяПоля);
	Если ПустаяСтрока(Строка(СтруктураДанных[ИмяПоля])) Тогда
		ВызватьИсключение "Не заполнено поле " + ИмяПоля;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПоложительноеЧисло(СтруктураДанных, ИмяПоля)

	ПроверитьПоле(СтруктураДанных, ИмяПоля);
	Если СтруктураДанных[ИмяПоля] <= 0 Тогда
		ВызватьИсключение "Поле должно быть положительным: " + ИмяПоля;
	КонецЕсли;

КонецПроцедуры

Функция СтрокаБезПробелов(Значение)

	Возврат СтрЗаменить(Формат(Значение, "ЧГ=0"), Символы.НПП, "");

КонецФункции

#КонецОбласти
