#Область ПубличныйИнтерфейс

Процедура ЗаписатьИнформацию(Событие, ПсевдонимБрокера, ИдентификаторСообщения = "", Код = "ok") Экспорт

	Представление = ПредставлениеСобытия(Событие, ПсевдонимБрокера, ИдентификаторСообщения, Код);
	ЗаписьЖурналаРегистрации(
		"KafkaIntegration." + БезопасноеСобытие(Событие),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Представление);

КонецПроцедуры

Процедура ЗаписатьОшибку(Событие, ПсевдонимБрокера, ИдентификаторСообщения, Код) Экспорт

	Представление = ПредставлениеСобытия(Событие, ПсевдонимБрокера, ИдентификаторСообщения, Код);
	ЗаписьЖурналаРегистрации(
		"KafkaIntegration." + БезопасноеСобытие(Событие),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Представление);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеСобытия(Событие, ПсевдонимБрокера, ИдентификаторСообщения, Код)

	Поля = Новый Массив;
	Поля.Добавить("event=" + БезопасноеСобытие(Событие));
	Поля.Добавить("broker=" + БезопасныйИдентификатор(ПсевдонимБрокера));
	Поля.Добавить("message=" + БезопасныйИдентификатор(ИдентификаторСообщения));
	Поля.Добавить("code=" + БезопасныйКод(Код));
	Возврат СтрСоединить(Поля, "; ");

КонецФункции

Функция БезопасноеСобытие(Событие)

	Разрешенные = Новый Массив;
	Разрешенные.Добавить("consume");
	Разрешенные.Добавить("produce");
	Разрешенные.Добавить("process");
	Если Разрешенные.Найти(Строка(Событие)) = Неопределено Тогда
		Возврат "unknown";
	КонецЕсли;
	Возврат Строка(Событие);

КонецФункции

Функция БезопасныйКод(Код)

	Разрешенные = Новый Массив;
	Разрешенные.Добавить("ok");
	Разрешенные.Добавить("not_acknowledged");
	Разрешенные.Добавить("transport_exception");
	Разрешенные.Добавить("handler_exception");
	Разрешенные.Добавить("lock_lost");
	Разрешенные.Добавить("invalid_message");
	Если Разрешенные.Найти(Строка(Код)) = Неопределено Тогда
		Возврат "unexpected_error";
	КонецЕсли;
	Возврат Строка(Код);

КонецФункции

Функция БезопасныйИдентификатор(Значение)

	СтрокаЗначения = Лев(Строка(Значение), 100);
	Результат = "";
	Для Позиция = 1 По СтрДлина(СтрокаЗначения) Цикл
		Символ = Сред(СтрокаЗначения, Позиция, 1);
		Если Найти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:", Символ) > 0 Тогда
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
