#Область ПубличныйИнтерфейс

Функция НоваяПолитика(
	МаксимумПопыток = 5,
	НачальнаяЗадержкаСекунд = 30,
	МаксимальнаяЗадержкаСекунд = 3600) Экспорт

	Если МаксимумПопыток < 1 Тогда
		ВызватьИсключение "Максимум попыток должен быть положительным";
	КонецЕсли;
	Если НачальнаяЗадержкаСекунд < 1 Тогда
		ВызватьИсключение "Начальная задержка должна быть положительной";
	КонецЕсли;
	Если МаксимальнаяЗадержкаСекунд < НачальнаяЗадержкаСекунд Тогда
		ВызватьИсключение "Максимальная задержка меньше начальной";
	КонецЕсли;

	Политика = Новый Структура;
	Политика.Вставить("МаксимумПопыток", МаксимумПопыток);
	Политика.Вставить("НачальнаяЗадержкаСекунд", НачальнаяЗадержкаСекунд);
	Политика.Вставить("МаксимальнаяЗадержкаСекунд", МаксимальнаяЗадержкаСекунд);
	Возврат Политика;

КонецФункции

Функция ЗадержкаСекунд(КоличествоПопыток, Политика) Экспорт

	Степень = Макс(0, КоличествоПопыток - 1);
	Задержка = Политика.НачальнаяЗадержкаСекунд * Pow(2, Степень);
	Возврат Мин(Задержка, Политика.МаксимальнаяЗадержкаСекунд);

КонецФункции

Функция СледующаяПопытка(КоличествоПопыток, Политика, Момент = Неопределено) Экспорт

	Если Момент = Неопределено Тогда
		Момент = ТекущаяДатаСеанса();
	КонецЕсли;
	Возврат Момент + ЗадержкаСекунд(КоличествоПопыток, Политика);

КонецФункции

Функция ПопыткиИсчерпаны(КоличествоПопыток, Политика) Экспорт

	Возврат КоличествоПопыток >= Политика.МаксимумПопыток;

КонецФункции

#КонецОбласти
