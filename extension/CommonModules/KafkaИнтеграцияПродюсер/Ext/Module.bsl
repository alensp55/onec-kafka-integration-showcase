#Область ПубличныйИнтерфейс

Функция ОтправитьПакет(Транспорт, Настройки, ПолитикаПовторов = Неопределено, Момент = Неопределено) Экспорт

	KafkaИнтеграцияКонтракты.ПроверитьНастройки(Настройки);
	Если ПустаяСтрока(Настройки.ТопикИсходящих) Тогда
		ВызватьИсключение "Не задан топик исходящих сообщений";
	КонецЕсли;
	Если ПолитикаПовторов = Неопределено Тогда
		ПолитикаПовторов = KafkaИнтеграцияПовторы.НоваяПолитика(Настройки.МаксимумПопыток);
	КонецЕсли;
	Если Момент = Неопределено Тогда
		Момент = ТекущаяДатаСеанса();
	КонецЕсли;

	Сообщения = KafkaИнтеграцияХранилище.ПолучитьКОтправке(
		Настройки.ВидОбмена,
		Момент,
		ПолитикаПовторов.МаксимумПопыток,
		Настройки.РазмерПакета);
	Статистика = НоваяСтатистика(Сообщения.Количество());

	Для Каждого Сообщение Из Сообщения Цикл
		ОтправитьСообщение(Транспорт, Настройки, Сообщение, ПолитикаПовторов, Момент, Статистика);
	КонецЦикла;

	Возврат Статистика;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьСообщение(Транспорт, Настройки, Сообщение, ПолитикаПовторов, Момент, Статистика)

	ИдентификаторБлокировки = KafkaИнтеграцияХранилище.ПопытатьсяЗахватить(Сообщение, Момент);
	Если ПустаяСтрока(ИдентификаторБлокировки) Тогда
		Статистика.Пропущено = Статистика.Пропущено + 1;
		Возврат;
	КонецЕсли;

	Заголовки = KafkaИнтеграцияКонтракты.ДесериализоватьЗаголовки(Сообщение.ЗаголовкиJSON);
	Заголовки.Вставить("message-id", Сообщение.ИдентификаторСообщения);

	Попытка
		РезультатОтправки = Транспорт.Отправить(
			Сообщение.Топик,
			Сообщение.КлючСообщения,
			Сообщение.ТекстСообщения,
			Заголовки);
	Исключение
		ЗавершитьОшибкой(
			Сообщение,
			ИдентификаторБлокировки,
			"transport_exception",
			ПолитикаПовторов,
			Настройки,
			Момент,
			Статистика);
		Возврат;
	КонецПопытки;

	Если Подтверждено(РезультатОтправки) Тогда
		Завершено = KafkaИнтеграцияХранилище.ЗавершитьУспешно(
			Сообщение,
			ИдентификаторБлокировки,
			"ok",
			Момент);
		Если Завершено Тогда
			Статистика.Отправлено = Статистика.Отправлено + 1;
			KafkaИнтеграцияБезопасныйЖурнал.ЗаписатьИнформацию(
				"produce",
				Настройки.ПсевдонимБрокера,
				Сообщение.ИдентификаторСообщения);
		Иначе
			Статистика.ПотеряноБлокировок = Статистика.ПотеряноБлокировок + 1;
		КонецЕсли;
	Иначе
		ЗавершитьОшибкой(
			Сообщение,
			ИдентификаторБлокировки,
			"not_acknowledged",
			ПолитикаПовторов,
			Настройки,
			Момент,
			Статистика);
	КонецЕсли;

КонецПроцедуры

Процедура ЗавершитьОшибкой(
	Сообщение,
	ИдентификаторБлокировки,
	Код,
	ПолитикаПовторов,
	Настройки,
	Момент,
	Статистика)

	Завершено = KafkaИнтеграцияХранилище.ЗавершитьОшибкой(
		Сообщение,
		ИдентификаторБлокировки,
		Код,
		ПолитикаПовторов,
		Момент);
	Если Завершено Тогда
		Статистика.Ошибок = Статистика.Ошибок + 1;
		KafkaИнтеграцияБезопасныйЖурнал.ЗаписатьОшибку(
			"produce",
			Настройки.ПсевдонимБрокера,
			Сообщение.ИдентификаторСообщения,
			Код);
	Иначе
		Статистика.ПотеряноБлокировок = Статистика.ПотеряноБлокировок + 1;
	КонецЕсли;

КонецПроцедуры

Функция Подтверждено(РезультатОтправки)

	Если НЕ РезультатОтправки.Свойство("Успешно") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ РезультатОтправки.Свойство("Подтверждено") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат РезультатОтправки.Успешно И РезультатОтправки.Подтверждено;

КонецФункции

Функция НоваяСтатистика(Выбрано)

	Статистика = Новый Структура;
	Статистика.Вставить("Выбрано", Выбрано);
	Статистика.Вставить("Отправлено", 0);
	Статистика.Вставить("Ошибок", 0);
	Статистика.Вставить("Пропущено", 0);
	Статистика.Вставить("ПотеряноБлокировок", 0);
	Возврат Статистика;

КонецФункции

#КонецОбласти
