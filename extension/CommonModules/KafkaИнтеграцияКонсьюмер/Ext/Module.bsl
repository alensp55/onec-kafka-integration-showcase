#Область ПубличныйИнтерфейс

Функция ПрочитатьПакет(Транспорт, Настройки) Экспорт

	KafkaИнтеграцияКонтракты.ПроверитьНастройки(Настройки);
	Если ПустаяСтрока(Настройки.ТопикВходящих) Тогда
		ВызватьИсключение "Не задан топик входящих сообщений";
	КонецЕсли;

	ПолученныеСообщения = Транспорт.Прочитать(Настройки.РазмерПакета, Настройки.ТаймаутОпросаМс);
	Статистика = НоваяСтатистика(ПолученныеСообщения.Количество());

	Для Каждого ПолученноеСообщение Из ПолученныеСообщения Цикл
		Сообщение = ПреобразоватьСообщение(ПолученноеСообщение, Настройки);
		Если KafkaИнтеграцияХранилище.ДобавитьЕслиОтсутствует(Сообщение) Тогда
			Статистика.Добавлено = Статистика.Добавлено + 1;
		Иначе
			Статистика.Дубликатов = Статистика.Дубликатов + 1;
		КонецЕсли;
	КонецЦикла;

	Если ПолученныеСообщения.Количество() > 0 Тогда
		Транспорт.Подтвердить(ПолученныеСообщения);
		Статистика.Подтверждено = ПолученныеСообщения.Количество();
	КонецЕсли;

	KafkaИнтеграцияБезопасныйЖурнал.ЗаписатьИнформацию(
		"consume",
		Настройки.ПсевдонимБрокера,
		,
		"ok");
	Возврат Статистика;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПреобразоватьСообщение(ПолученноеСообщение, Настройки)

	Если ПолученноеСообщение.Топик <> Настройки.ТопикВходящих Тогда
		ВызватьИсключение "Транспорт вернул сообщение другого топика";
	КонецЕсли;

	Возврат KafkaИнтеграцияКонтракты.НовоеВходящееСообщение(
		Настройки.ВидОбмена,
		ПолученноеСообщение.Топик,
		ПолученноеСообщение.Ключ,
		ПолученноеСообщение.Тело,
		ПолученноеСообщение.Заголовки,
		ПолученноеСообщение.Партиция,
		ПолученноеСообщение.Смещение,
		ПолученноеСообщение.ВременнаяМетка);

КонецФункции

Функция НоваяСтатистика(Получено)

	Статистика = Новый Структура;
	Статистика.Вставить("Получено", Получено);
	Статистика.Вставить("Добавлено", 0);
	Статистика.Вставить("Дубликатов", 0);
	Статистика.Вставить("Подтверждено", 0);
	Возврат Статистика;

КонецФункции

#КонецОбласти
