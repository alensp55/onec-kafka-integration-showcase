#Область ПубличныйИнтерфейс

Функция ДобавитьЕслиОтсутствует(Сообщение) Экспорт

	KafkaИнтеграцияКонтракты.ПроверитьСообщение(Сообщение);
	ВидСообщения = ВидСообщенияПоИмени(Сообщение.ВидСообщения);

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКлюч(Сообщение.ВидОбмена, ВидСообщения, Сообщение.ИдентификаторСообщения);
		Менеджер = МенеджерСообщения(
			Сообщение.ВидОбмена,
			ВидСообщения,
			Сообщение.ИдентификаторСообщения);

		Если Менеджер.Выбран() Тогда
			ЗафиксироватьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		ЗаполнитьНовоеСообщение(Менеджер, Сообщение);
		Менеджер.Записать();
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция ПолучитьКОтправке(ВидОбмена, Момент, МаксимумПопыток, МаксимумСообщений) Экспорт

	Возврат ПолучитьДоступные(
		ВидОбмена,
		Перечисления.KafkaВидыСообщений.Исходящее,
		Момент,
		МаксимумПопыток,
		МаксимумСообщений);

КонецФункции

Функция ПолучитьКОбработке(ВидОбмена, Момент, МаксимумПопыток, МаксимумСообщений) Экспорт

	Возврат ПолучитьДоступные(
		ВидОбмена,
		Перечисления.KafkaВидыСообщений.Входящее,
		Момент,
		МаксимумПопыток,
		МаксимумСообщений);

КонецФункции

Функция ПопытатьсяЗахватить(Сообщение, Момент, СекундыБлокировки = 300) Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКлюч(
			Сообщение.ВидОбмена,
			Сообщение.ВидСообщения,
			Сообщение.ИдентификаторСообщения);
		Менеджер = МенеджерСообщения(
			Сообщение.ВидОбмена,
			Сообщение.ВидСообщения,
			Сообщение.ИдентификаторСообщения);

		Если НЕ МожноЗахватить(Менеджер, Момент) Тогда
			ЗафиксироватьТранзакцию();
			Возврат "";
		КонецЕсли;

		ИдентификаторБлокировки = Строка(Новый УникальныйИдентификатор);
		Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.ВРаботе;
		Менеджер.ИдентификаторБлокировки = ИдентификаторБлокировки;
		Менеджер.ЗаблокированоДо = Момент + СекундыБлокировки;
		Менеджер.Версия = Менеджер.Версия + 1;
		Менеджер.Записать();
		ЗафиксироватьТранзакцию();
		Возврат ИдентификаторБлокировки;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция ЗавершитьУспешно(Сообщение, ИдентификаторБлокировки, КодРезультата, Момент) Экспорт

	НачатьТранзакцию();
	Попытка
		Менеджер = ЗаблокированныйМенеджер(Сообщение);
		Если НЕ БлокировкаПринадлежит(Менеджер, ИдентификаторБлокировки) Тогда
			ЗафиксироватьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.Обработано;
		Менеджер.ДатаОбработки = Момент;
		Менеджер.СледующаяПопытка = ПустаяДата();
		Менеджер.КодРезультата = Лев(Строка(КодРезультата), 100);
		ОчиститьБлокировку(Менеджер);
		Менеджер.Версия = Менеджер.Версия + 1;
		Менеджер.Записать();
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция ЗавершитьОшибкой(
	Сообщение,
	ИдентификаторБлокировки,
	КодРезультата,
	ПолитикаПовторов,
	Момент) Экспорт

	НачатьТранзакцию();
	Попытка
		Менеджер = ЗаблокированныйМенеджер(Сообщение);
		Если НЕ БлокировкаПринадлежит(Менеджер, ИдентификаторБлокировки) Тогда
			ЗафиксироватьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		Менеджер.КоличествоПопыток = Менеджер.КоличествоПопыток + 1;
		Если KafkaИнтеграцияПовторы.ПопыткиИсчерпаны(Менеджер.КоличествоПопыток, ПолитикаПовторов) Тогда
			Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.Отклонено;
			Менеджер.ДатаОбработки = Момент;
			Менеджер.СледующаяПопытка = ПустаяДата();
		Иначе
			Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.Ошибка;
			Менеджер.СледующаяПопытка = KafkaИнтеграцияПовторы.СледующаяПопытка(
				Менеджер.КоличествоПопыток,
				ПолитикаПовторов,
				Момент);
		КонецЕсли;

		Менеджер.КодРезультата = Лев(Строка(КодРезультата), 100);
		ОчиститьБлокировку(Менеджер);
		Менеджер.Версия = Менеджер.Версия + 1;
		Менеджер.Записать();
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДоступные(ВидОбмена, ВидСообщения, Момент, МаксимумПопыток, МаксимумСообщений)

	Если МаксимумСообщений < 1 Тогда
		ВызватьИсключение "Размер пакета должен быть положительным";
	КонецЕсли;
	Лимит = СтрЗаменить(Формат(Цел(МаксимумСообщений), "ЧГ=0"), Символы.НПП, "");
	Лимит = СтрЗаменить(Лимит, " ", "");

	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.KafkaСтатусыСообщений.Создано);
	Статусы.Добавить(Перечисления.KafkaСтатусыСообщений.Ошибка);
	Статусы.Добавить(Перечисления.KafkaСтатусыСообщений.ВРаботе);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ %Лимит%
		|KafkaСообщения.ВидОбмена КАК ВидОбмена,
		|KafkaСообщения.ВидСообщения КАК ВидСообщения,
		|KafkaСообщения.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|KafkaСообщения.ИдентификаторПакета КАК ИдентификаторПакета,
		|KafkaСообщения.Топик КАК Топик,
		|KafkaСообщения.КлючСообщения КАК КлючСообщения,
		|KafkaСообщения.ТекстСообщения КАК ТекстСообщения,
		|KafkaСообщения.ЗаголовкиJSON КАК ЗаголовкиJSON,
		|KafkaСообщения.Партиция КАК Партиция,
		|KafkaСообщения.Смещение КАК Смещение,
		|KafkaСообщения.ДатаСоздания КАК ДатаСоздания,
		|KafkaСообщения.КоличествоПопыток КАК КоличествоПопыток
		|ИЗ
		|	РегистрСведений.KafkaСообщения КАК KafkaСообщения
		|ГДЕ
		|	KafkaСообщения.ВидОбмена = &ВидОбмена
		|	И KafkaСообщения.ВидСообщения = &ВидСообщения
		|	И KafkaСообщения.Статус В (&Статусы)
		|	И KafkaСообщения.КоличествоПопыток < &МаксимумПопыток
		|	И (KafkaСообщения.СледующаяПопытка = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ KafkaСообщения.СледующаяПопытка <= &Момент)
		|	И (KafkaСообщения.ЗаблокированоДо = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ KafkaСообщения.ЗаблокированоДо <= &Момент)
		|УПОРЯДОЧИТЬ ПО
		|	KafkaСообщения.ДатаСоздания,
		|	KafkaСообщения.ИдентификаторСообщения";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Лимит%", Лимит);
	Запрос.УстановитьПараметр("ВидОбмена", ВидОбмена);
	Запрос.УстановитьПараметр("ВидСообщения", ВидСообщения);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток);
	Запрос.УстановитьПараметр("Момент", Момент);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ЗаполнитьНовоеСообщение(Менеджер, Сообщение)

	Менеджер.ИдентификаторПакета = Сообщение.ИдентификаторПакета;
	Менеджер.Топик = Сообщение.Топик;
	Менеджер.КлючСообщения = Сообщение.КлючСообщения;
	Менеджер.ТекстСообщения = Сообщение.ТекстСообщения;
	Менеджер.ЗаголовкиJSON = KafkaИнтеграцияКонтракты.СериализоватьЗаголовки(Сообщение.Заголовки);
	Менеджер.Партиция = Сообщение.Партиция;
	Менеджер.Смещение = Сообщение.Смещение;
	Менеджер.ДатаСоздания = Сообщение.ДатаСоздания;
	Менеджер.ДатаОбработки = ПустаяДата();
	Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.Создано;
	Менеджер.КоличествоПопыток = 0;
	Менеджер.СледующаяПопытка = ПустаяДата();
	Менеджер.ИдентификаторБлокировки = "";
	Менеджер.ЗаблокированоДо = ПустаяДата();
	Менеджер.Версия = 1;
	Менеджер.КодРезультата = "";

КонецПроцедуры

Функция МенеджерСообщения(ВидОбмена, ВидСообщения, ИдентификаторСообщения)

	Менеджер = РегистрыСведений.KafkaСообщения.СоздатьМенеджерЗаписи();
	Менеджер.ВидОбмена = ВидОбмена;
	Менеджер.ВидСообщения = ВидСообщения;
	Менеджер.ИдентификаторСообщения = ИдентификаторСообщения;
	Менеджер.Прочитать();
	Возврат Менеджер;

КонецФункции

Функция ЗаблокированныйМенеджер(Сообщение)

	ЗаблокироватьКлюч(
		Сообщение.ВидОбмена,
		Сообщение.ВидСообщения,
		Сообщение.ИдентификаторСообщения);
	Возврат МенеджерСообщения(
		Сообщение.ВидОбмена,
		Сообщение.ВидСообщения,
		Сообщение.ИдентификаторСообщения);

КонецФункции

Процедура ЗаблокироватьКлюч(ВидОбмена, ВидСообщения, ИдентификаторСообщения)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.KafkaСообщения");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("ВидОбмена", ВидОбмена);
	Элемент.УстановитьЗначение("ВидСообщения", ВидСообщения);
	Элемент.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
	Блокировка.Заблокировать();

КонецПроцедуры

Функция МожноЗахватить(Менеджер, Момент)

	Если НЕ Менеджер.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.Обработано
		Или Менеджер.Статус = Перечисления.KafkaСтатусыСообщений.Отклонено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Менеджер.ЗаблокированоДо) И Менеджер.ЗаблокированоДо > Момент Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Менеджер.СледующаяПопытка) И Менеджер.СледующаяПопытка > Момент Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция БлокировкаПринадлежит(Менеджер, ИдентификаторБлокировки)

	Возврат Менеджер.Выбран()
		И НЕ ПустаяСтрока(ИдентификаторБлокировки)
		И Менеджер.ИдентификаторБлокировки = ИдентификаторБлокировки;

КонецФункции

Процедура ОчиститьБлокировку(Менеджер)

	Менеджер.ИдентификаторБлокировки = "";
	Менеджер.ЗаблокированоДо = ПустаяДата();

КонецПроцедуры

Функция ВидСообщенияПоИмени(Имя)

	Если Имя = "Входящее" Тогда
		Возврат Перечисления.KafkaВидыСообщений.Входящее;
	ИначеЕсли Имя = "Исходящее" Тогда
		Возврат Перечисления.KafkaВидыСообщений.Исходящее;
	КонецЕсли;
	ВызватьИсключение "Неизвестный вид Kafka-сообщения";

КонецФункции

Функция ПустаяДата()

	Возврат Дата(1, 1, 1);

КонецФункции

#КонецОбласти
