#Область ПубличныйИнтерфейс

Функция ПрочитатьВходящие(ФабрикаТранспорта, ВидОбмена) Экспорт

	Настройки = ПолучитьНастройки(ВидОбмена);
	Если НЕ Настройки.Включен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Транспорт = ФабрикаТранспорта.СоздатьКонсьюмер(Настройки);
	Возврат KafkaИнтеграцияКонсьюмер.ПрочитатьПакет(Транспорт, Настройки);

КонецФункции

Функция ОтправитьИсходящие(ФабрикаТранспорта, ВидОбмена) Экспорт

	Настройки = ПолучитьНастройки(ВидОбмена);
	Если НЕ Настройки.Включен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Транспорт = ФабрикаТранспорта.СоздатьПродюсер(Настройки);
	Политика = KafkaИнтеграцияПовторы.НоваяПолитика(Настройки.МаксимумПопыток);
	Возврат KafkaИнтеграцияПродюсер.ОтправитьПакет(Транспорт, Настройки, Политика);

КонецФункции

Функция ОбработатьВходящие(ФабрикаОбработчика, ВидОбмена) Экспорт

	Настройки = ПолучитьНастройки(ВидОбмена);
	Если НЕ Настройки.Включен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Обработчик = ФабрикаОбработчика.Создать(Настройки);
	Политика = KafkaИнтеграцияПовторы.НоваяПолитика(Настройки.МаксимумПопыток);
	Возврат KafkaИнтеграцияОбработчикВходящих.ОбработатьПакет(Обработчик, Настройки, Политика);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьНастройки(ВидОбмена)

	ОбъектНастроек = ВидОбмена.ПолучитьОбъект();
	Настройки = KafkaИнтеграцияКонтракты.НовыеНастройки(
		ВидОбмена,
		ОбъектНастроек.ПсевдонимБрокера,
		ОбъектНастроек.ТопикВходящих,
		ОбъектНастроек.ТопикИсходящих,
		ОбъектНастроек.ГруппаКонсьюмера,
		ОбъектНастроек.КлиентПродюсера,
		ОбъектНастроек.РазмерПакета,
		ОбъектНастроек.ТаймаутОпросаМс,
		ОбъектНастроек.МаксимумПопыток);
	Настройки.Вставить("Включен", ОбъектНастроек.Включен);
	Возврат Настройки;

КонецФункции

#КонецОбласти
